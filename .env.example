# Nothing is required for local development: without DATABASE_URL the app uses
# PGlite (Postgres in WebAssembly) stored in .data/, and the admin password is
# the public demo password shown on /admin/login.

# Postgres connection string (Neon in production). Run `npm run db:migrate` once.
DATABASE_URL=

# Required in production: secret for signing the admin session cookie (32+ chars).
SESSION_SECRET=

# Optional: a private admin password. Unset = public demo password "rampa-demo".
ADMIN_PASSWORD=

# Optional: Telegram notification for every new booking.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron sends this as a bearer token to /api/cron/demo.
CRON_SECRET=

# Public URL, used in metadata, robots.txt and sitemap.xml.
SITE_URL=http://localhost:3000
